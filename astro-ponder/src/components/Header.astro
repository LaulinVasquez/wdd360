---
import HeaderLink from './HeaderLink.astro';
---

<header>
    <h1>Astro</h1>
    <nav>
        <HeaderLink href="/">Home</HeaderLink>
        <HeaderLink href="/contact">Contact</HeaderLink>
    </nav>
</header>

<style>
    header {
        background-color: #333;
        color: white;
        padding: 1rem;
        align-items: center;
    }

    nav ul {
        list-style-type: none;
        padding: 0;
    }

    nav li {
        display: inline;
        margin-right: 1rem;
    }

    nav a {
        color: white;
        text-decoration: none;
    }

    nav a:hover {
        text-decoration: underline;
    }
    
</style>